{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.geekflare/mcp",
  "description": "Web scraping, search, screenshots and website checks for AI agents. Hosted, sign-in or API key.",
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@geekflare/mcp",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_KEY",
          "description": "Your Geekflare API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "geekflarehq/geekflare-api-mcp:0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_KEY",
          "description": "Your Geekflare API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.geekflare.com/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://mcp.geekflare.com/{API_KEY}/mcp",
      "variables": {
        "API_KEY": {
          "description": "Your Geekflare API key",
          "isRequired": true
        }
      }
    }
  ]
}
