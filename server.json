{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.geekflare/mcp",
  "title": "Geekflare",
  "description": "Web scraping, search, screenshots and website checks for AI agents. Hosted, sign-in or API key.",
  "repository": {
    "url": "https://github.com/geekflare/geekflare-api-mcp",
    "source": "github"
  },
  "version": "0.5.1",
  "websiteUrl": "https://geekflare.com/mcp/",
  "icons": [
    {
      "src": "https://cdn.geekflare.com/general/favicon-transparent.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@geekflare/mcp",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_KEY",
          "description": "Your Geekflare API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "geekflarehq/geekflare-api-mcp:0.5.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "API_KEY",
          "description": "Your Geekflare API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.geekflare.com/mcp"
    },
    {
      "type": "streamable-http",
      "url": "https://mcp.geekflare.com/{API_KEY}/mcp",
      "variables": {
        "API_KEY": {
          "description": "Your Geekflare API key",
          "isRequired": true,
          "isSecret": true
        }
      }
    }
  ]
}
